<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DeviceDefault dark (plain black background — the portrait must NEVER become the app
         wallpaper) + the launch story: the system's pre-draw splash shows her face in the icon
         circle while the process starts, then the Compose overlay in HermesScaffold flashes her
         full-bleed for ~900ms and hands off to the chat. -->
    <style name="Theme.HermesWear" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_hermes_orb</item>
        <item name="android:windowSplashScreenBackground">#07070C</item>
    </style>

    <!-- BATCH-6 #23: the core-splashscreen Starting theme. API 31+ uses the platform splash
         (the windowSplashScreen* items above read through), API 30 falls back to the library's
         window-background path — both hand the running app this theme after the show (or the
         140 ms fade) completes. -->
    <style name="Theme.HermesWear.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_hermes_orb</item>
        <item name="windowSplashScreenBackground">#07070C</item>
        <item name="postSplashScreenTheme">@style/Theme.HermesWear</item>
    </style>
</resources>
